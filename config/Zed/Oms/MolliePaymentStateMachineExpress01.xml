<?xml version="1.0" encoding="utf-8"?>
<statemachine
        xmlns="http://static.spryker.com"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://static.spryker.com http://static.spryker.com/oms-01.xsd">

    <process name="MolliePaymentStateMachineExpress01" main="true">
        <subprocesses>
            <process>MolliePayment</process>
            <process>MollieRefund</process>
            <process>MollieExpressRefund</process>
        </subprocesses>
    </process>

    <process name="MolliePayment" file="PaymentSubprocess/Payment01.xml"/>
    <process name="MollieRefund" file="RefundSubprocess/Refund01.xml"/>
    <process name="MollieExpressRefund" file="ExpressRefundSubprocess/ExpressRefund01.xml"/>

</statemachine>
