{% extends template('widget') %}

{% define data = {
    isActivePage: _widget.isActivePage,
    isVisible: _widget.isVisible,
} %}

{% block body %}
    {% if data.isVisible %}
        {% include molecule('navigation-sidebar-item') ignore missing with {
            modifiers: data.isActivePage ? ['active'] : [],
            data: {
                url: url('customer/saved-cards'),
                icon: 'lock',
                label: 'mollie.customer.saved_cards.menu' | trans,
                name: 'mollie-saved-cards',
            },
        } only %}
    {% endif %}
{% endblock %}
